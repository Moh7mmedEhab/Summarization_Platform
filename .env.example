# ---------- Database (PostgreSQL) ----------
DATABASE_URL="postgresql://margins:margins@localhost:5432/margins"

# ---------- Better Auth ----------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public base URL of the app (used in verification / reset emails)
APP_URL="http://localhost:3000"

# ---------- Google AI Studio / Gemini ----------
GEMINI_API_KEY=
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_TRANSCRIBE_MODEL="gemini-3.5-transcribe"

# ---------- Email ----------
# "dev" logs the message to the server console and writes .eml files into storage/mail-outbox
# (no real email is sent when the provider is "dev" and none is configured).
EMAIL_PROVIDER="dev"
# SMTP (used when EMAIL_PROVIDER="smtp") — e.g. smtps://user:password@smtp.example.com:465
EMAIL_SMTP_URL=
EMAIL_FROM="Margins <no-reply@margins.local>"

# ---------- Private file storage ----------
# Root directory for private uploads (never served publicly)
STORAGE_DIR="./storage"
# Upload limits
UPLOAD_MAX_SOURCE_BYTES="52428800"   # 50 MB: PDF / DOCX / TXT / images
UPLOAD_MAX_AUDIO_BYTES="52428800"    # 50 MB: lecture recordings
UPLOAD_MAX_TEXT_CHARS="200000"       # pasted text
MAX_UPLOAD_TOTAL_BYTES="104857600"   # 100 MB across one upload's files + text
AUDIO_MAX_DURATION_SEC="10800"       # 3 h: recordings over this are rejected
JOB_TIMEOUT_MS="900000"              # 15 min per job; provider calls aborted after

# ---------- Worker (npm run worker) ----------
WORKER_POLL_INTERVAL_MS="2000"
